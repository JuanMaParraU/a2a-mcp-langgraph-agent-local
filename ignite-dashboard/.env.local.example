# IGNITE Dashboard Environment Variables
# Copy this file to .env.local and adjust values as needed.

# Orchestrator Agent base URL (A2A protocol, health checks, metrics, WebSocket events)
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:9990

# Research Agent base URL (A2A protocol, health checks)
NEXT_PUBLIC_RESEARCH_AGENT_URL=http://localhost:9991

# MCP Server base URL (health checks)
NEXT_PUBLIC_MCP_SERVER_URL=http://localhost:8000
